@FunEvents.Api_HostAddress = http://localhost:5053
@ApiKey = c29b452e5f85cd802e0940699f5e1a33295ed3a43afbe202472c625442752764
@IdempotencyKey = reservation-demo-001

### Create a reservation
# Run this first. Use a new IdempotencyKey for a new reservation attempt.
# Keep the same key and request body when retrying this operation.
# @name createReservation
POST {{FunEvents.Api_HostAddress}}/api/v1/reservations
X-Api-Key: {{ApiKey}}
Idempotency-Key: {{IdempotencyKey}}
Content-Type: application/json
Accept: application/json

{
  "eventCode": "EVT-001",
  "sessionCode": "SES-001-A",
  "userCode": "USR-042",
  "quantity": 2
}

@reservationCode = {{createReservation.response.body.$.reservationCode}}

### Retry the create request with the same idempotency key
# This should return the original reservation instead of reserving tickets again.
POST {{FunEvents.Api_HostAddress}}/api/v1/reservations
X-Api-Key: {{ApiKey}}
Idempotency-Key: {{IdempotencyKey}}
Content-Type: application/json
Accept: application/json

{
  "eventCode": "EVT-001",
  "sessionCode": "SES-001-A",
  "userCode": "USR-042",
  "quantity": 2
}

### Get the created reservation
GET {{FunEvents.Api_HostAddress}}/api/v1/reservations/{{reservationCode}}
X-Api-Key: {{ApiKey}}
Accept: application/json

### Cancel the created reservation
POST {{FunEvents.Api_HostAddress}}/api/v1/reservations/{{reservationCode}}/cancel
X-Api-Key: {{ApiKey}}
Accept: application/json

### Health check
GET {{FunEvents.Api_HostAddress}}/health
Accept: application/json

###
